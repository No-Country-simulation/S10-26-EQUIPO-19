# URL base de la API del backend (FastAPI).
# API desplegada en Render. Para usar la API levantada en tu computador: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=https://openbridge-rcv2.onrender.com/api/v1
# false: consulta la API real. true: usa los datos de ejemplo (data/mock.ts), por ejemplo sin conexión.
NEXT_PUBLIC_USE_MOCK=false
# 9.2: true muestra el botón del docker-compose en el asistente (cuando exista el servicio /compose).
NEXT_PUBLIC_ENABLE_COMPOSE=false
